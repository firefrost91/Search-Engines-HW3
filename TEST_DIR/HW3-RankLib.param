{
    "indexPath": "INPUT_DIR/index-cw09",

    "queryFilePath": "TEST_DIR/HW3-queries.qry",

"task_1:ranker": {
  "type": "inRankFile",
  "inRankFile:Path": "OUTPUT_DIR/HW3-BM25.inRank",
  "outputLength": "1000"
},

    "task_2:reranker": {
        "type": "ltr",
        "rerankDepth": "100",

        "ltr:toolkit": "RankLib",

        "ltr:trainingQueryFile": "TEST_DIR/HW3-train-queries.qry",
        "ltr:trainingQrelsFile": "TEST_DIR/HW3-train.qrels",

        "ltr:trainingFeatureVectorsFile": "OUTPUT_DIR/HW3-train.fv",
        "ltr:testingFeatureVectorsFile": "OUTPUT_DIR/HW3-test.fv",
        "ltr:testingDocumentScores": "OUTPUT_DIR/HW3-test.scores",

        "ltr:modelFile": "OUTPUT_DIR/HW3-ranklib.model",

        "ltr:RankLib:model": "4",
        "ltr:RankLib:metric2t": "MAP",

        "ltr:BM25:b": "0.75",
        "ltr:BM25:k_1": "1.2",
        "ltr:QL:mu": "2500"
    },

    "task_4:output": {
        "type": "trec_eval",
        "outputPath": "OUTPUT_DIR/HW3-Exp-1.teIn",
        "outputLength": "1000"
    }
}
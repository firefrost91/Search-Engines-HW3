{
    "indexPath": "INPUT_DIR/index-cw09",
    "queryFilePath": "EXP_DIR/queries.qry",
    "task_1:ranker": {
        "type": "inRankFile",
        "inRankFile:Path": "EXP_DIR/output/queries.inRank"
    },
    "task_2:rewriter": {
        "type": "prf",
        "prf:algorithm": "rm3",
        "prf:expansionFieldIn": "body",
        "prf:expansionFieldOut": "body",
        "prf:expansionQueryFile": "EXP_DIR/output/Exp-1.2e.qryOut",
        "prf:numDocs": "50",
        "prf:numTerms": "20",
        "prf:rm3:origWeight": "0"
    },
    "task_3:reranker": {
        "type": "ltr",
        "rerankDepth": "100",
        "ltr:BM25:b": "0.75",
        "ltr:BM25:k_1": "1.2",
        "ltr:QL:mu": "2500",
        "ltr:featureDisable": "17,18,19,20",
        "ltr:toolkit": "RankLib",
        "ltr:RankLib:model": "4",
        "ltr:RankLib:metric2t": "MAP",
        "ltr:trainingQueryFile": "EXP_DIR/training_queries.qry",
        "ltr:trainingQrelsFile": "EXP_DIR/training_qrels.qrels",
        "ltr:trainingFeatureVectorsFile": "EXP_DIR/output/Exp-1.2e.LtrTrain",
        "ltr:modelFile": "EXP_DIR/output/Exp-1.2e.Model",
        "ltr:testingFeatureVectorsFile": "EXP_DIR/output/Exp-1.2e.LtrTest",
        "ltr:testingDocumentScores": "EXP_DIR/output/Exp-1.2e.DocScore"
    },
    "task_4:output": {
        "type": "trec_eval",
        "outputPath": "EXP_DIR/output/Exp-1.2e.teIn",
        "outputLength": "1000"
    }
}

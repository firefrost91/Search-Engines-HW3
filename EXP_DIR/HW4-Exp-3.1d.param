{
    "indexPath": "INPUT_DIR/index-cw09",
    "queryFilePath": "EXP_DIR/Exp-4.qry",
  "task_1:ranker": {
    "type": "inRankFile",
    "inRankFile:Path": "EXP_DIR/output/queries.inRank",
    "inRankFile:outputLength": "1000"
  },
    "task_2:rewriter": {
        "type": "prf",
        "prf:algorithm": "rm3",
        "prf:numDocs": "25",
        "prf:numTerms": "3",
        "prf:expansionFieldIn": "body",
        "prf:expansionFieldOut": "body",
        "prf:expansionQueryFile": "OUTPUT_DIR/HW4-Exp-3.1d.qryOut"
    },
    "task_3:ranker": {
        "outputLength": "500",
        "type": "BM25",
        "BM25:k_1": "1.2",
        "BM25:b": "0.75"
    },
    "task_5:reranker": {
        "type": "bertrr",
        "rerankDepth": "500",
        "bertrr:maxSeqLength": "512",
        "bertrr:modelPath": "INPUT_DIR/ms-marco-MiniLM-L-6-v2",
        "bertrr:scoreAggregation": "maxp",
        "bertrr:psgLen": "150",
        "bertrr:psgStride": "125",
        "bertrr:psgCnt": "6",
        "bertrr:maxTitleLength": "16"
    },
    "task_6:output": {
        "type": "trec_eval",
        "outputPath": "OUTPUT_DIR/HW4-Exp-3.1d.teIn",
        "outputLength": "1000"
    }
}
